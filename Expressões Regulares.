import re
import operator
from typing import List, Tuple

# -----------------------------------------------------------------------------------------------------------------
# 1- re.compile(...)
# - Constrói e “pré-compila” a expressão regular, tornando as buscas mais rápidas.
#
# 2- r""" ... """
# - O prefixo r indica raw string: os caracteres de escape (\) são lidos literalmente pela regex, sem precisar dobrá-los (\\).
#
# 3- re.VERBOSE
# - Permite quebrar a regex em varias linhas usar espacos e incluir comentarios (tudo depois de #)
# sem que isso seja interpretado como parte do padrao. fica muito mais legivel

PADRAO_TOKEN = re.compile(r"""
    (?P<INTEIRO>\d+)       # um ou mais dígitos
  | (?P<SOMA>\+)           # operador +
  | (?P<SUBTRACAO>-)       # operador -
  | (?P<MULTIPLICACAO>\*)  # operador *
  | (?P<DIVISAO>/)         # operador /
  | (?P<ABRE_PAREN>\()     # parêntese esquerdo
  | (?P<FECHA_PAREN>\))    # parêntese direito
  | (?P<ESPACO>\s+)        # espaços em branco (ignorados)
""", re.VERBOSE)
# -----------------------------------------------------------------------------------------------------------------


Token = Tuple[str, str]



# -----------------------------------------------------------------------------------------------------------------
# finditer varre a expressão original (expressao(input inserido pelo usuario)) e sempre que encontra um
# trecho que corresponde a qualquer uma das alternativas devolve um match object m


# m.lastgroup traz o nome do grupo que foi casado, permitindo identificar rapidamente se o lexema é um número
# , um operador, etc.

def tokenizar(expressao: str) -> List[Token]:
    """Converte a string de entrada em uma lista de tokens."""
    tokens: List[Token] = []
    for m in PADRAO_TOKEN.finditer(expressao):
        tipo = m.lastgroup
        if tipo == "ESPACO":        # ignora espaco
            continue
        tokens.append((tipo, m.group()))
    return tokens

# -----------------------------------------------------------------------------------------------------------------



# -----------------------------------------------------------------------------------------------------------------
# Cada valor inteiro e o nível de precedencia: quanto maior o numero, mais cedo o operador deve ser aplicado.
# nível 1 → + e -
# nível 2 → * e /
# Precedencia dos operadores
precedencia = {
    'SOMA': 1, 'SUBTRACAO': 1,
    'MULTIPLICACAO': 2, 'DIVISAO': 2,
}
# -----------------------------------------------------------------------------------------------------------------



# Implementacao dos operadores
operadores = {
    'SOMA': operator.add,
    'SUBTRACAO': operator.sub,
    'MULTIPLICACAO': operator.mul,
    'DIVISAO': operator.truediv,
}




# -----------------------------------------------------------------------------------------------------------------
"""

    • Números vão direto para a saída.  
    • Operadores são empilhados conforme a precedência.  
    • Parênteses garantem prioridade absoluta.

    Retorna a lista de tokens em RPN.
    """

def infixa_para_rpn(tokens: List[Token]) -> List[Token]:
    """Converte a lista de tokens em notacao infixa para pós‑fixa (RPN)."""
    saida: List[Token] = []
    pilha: List[Token] = []

    for tipo, lexema in tokens:
        if tipo == 'INTEIRO':
            saida.append((tipo, lexema))
        elif tipo in operadores:
            # Desempilha enquanto houver operador de precedência ≥
            while (pilha and pilha[-1][0] in operadores and
                   precedencia[tipo] <= precedencia[pilha[-1][0]]):
                saida.append(pilha.pop())
            pilha.append((tipo, lexema))
        elif tipo == 'ABRE_PAREN':
            pilha.append((tipo, lexema))
        elif tipo == 'FECHA_PAREN':
            # Desempilha ate encontrar '('
            while pilha and pilha[-1][0] != 'ABRE_PAREN':
                saida.append(pilha.pop())
            pilha.pop()        # descarta '('

    # Qualquer operador restante vai para a saída
    return saida + pilha[::-1]

def avaliar_rpn(rpn: List[Token]) -> float:
    """
       percorre a lista de tokens em RPN usando uma pilha:

       • Numero → empilha.
       • Operador → desempilha 2 valores aplica operacao empilha resultado

       retorna o calculo como float
       """
    """avalia a expressao em pos‑fixa retornando um float."""
    pilha: List[float] = []
    for tipo, lexema in rpn:
        if tipo == 'INTEIRO':
            pilha.append(int(lexema))
        else:
            b, a = pilha.pop(), pilha.pop()
            pilha.append(operadores[tipo](a, b))
    return pilha[0]
# -----------------------------------------------------------------------------------------------------------------



# ------------------------------------------------------------------------------------------------------------------
def principal() -> None:
    expressao = input("Digite a expressão matemática: ").strip()
    if not expressao:
        print("Erro: nenhuma expressão fornecida.", file=sys.stderr)
        sys.exit(1)

    tokens = tokenizar(expressao)
    print("TOKENS:", tokens)

    try:
        rpn = infixa_para_rpn(tokens)
        resultado = avaliar_rpn(rpn)
        print("VALOR :", resultado)
    except Exception as exc:
        print("Erro ao avaliar a expressão:", exc, file=sys.stderr)

if __name__ == "__main__":
    principal()

