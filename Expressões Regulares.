import re
import sys
import operator
from typing import List, Tuple


# 1. Definicao dos padroes de tokens (regex com grupos nomeados)

PADRAO_TOKEN = re.compile(r"""
    (?P<INTEIRO>\d+)       # um ou mais dígitos
  | (?P<SOMA>\+)           # operador +
  | (?P<SUBTRACAO>-)       # operador -
  | (?P<MULTIPLICACAO>\*)  # operador *
  | (?P<DIVISAO>/)         # operador /
  | (?P<ABRE_PAREN>\()     # parêntese esquerdo
  | (?P<FECHA_PAREN>\))    # parêntese direito
  | (?P<ESPACO>\s+)        # espaços em branco (ignorados)
""", re.VERBOSE)

Token = Tuple[str, str]  # (tipo, lexema)


# 2. Funcao de tokenizacao

def tokenizar(expressao: str) -> List[Token]:
    """Converte a string de entrada em uma lista de tokens."""
    tokens: List[Token] = []
    for m in PADRAO_TOKEN.finditer(expressao):
        tipo = m.lastgroup
        if tipo == "ESPACO":        # ignora espaços
            continue
        tokens.append((tipo, m.group()))
    return tokens


# 3. Conversao para RPN e avaliacao

# Precedencia dos operadores
precedencia = {
    'SOMA': 1, 'SUBTRACAO': 1,
    'MULTIPLICACAO': 2, 'DIVISAO': 2,
}

# Implementacoo dos operadores
operadores = {
    'SOMA': operator.add,
    'SUBTRACAO': operator.sub,
    'MULTIPLICACAO': operator.mul,
    'DIVISAO': operator.truediv,
}

def infixa_para_rpn(tokens: List[Token]) -> List[Token]:
    """Converte a lista de tokens em notação infixa para pós‑fixa (RPN)."""
    saida: List[Token] = []
    pilha: List[Token] = []

    for tipo, lexema in tokens:
        if tipo == 'INTEIRO':
            saida.append((tipo, lexema))
        elif tipo in operadores:
            while (pilha and pilha[-1][0] in operadores and
                   precedencia[tipo] <= precedencia[pilha[-1][0]]):
                saida.append(pilha.pop())
            pilha.append((tipo, lexema))
        elif tipo == 'ABRE_PAREN':
            pilha.append((tipo, lexema))
        elif tipo == 'FECHA_PAREN':
            while pilha and pilha[-1][0] != 'ABRE_PAREN':
                saida.append(pilha.pop())
            pilha.pop()        # descarta '('
    return saida + pilha[::-1]

def avaliar_rpn(rpn: List[Token]) -> float:
    """Avalia a expressão em pós‑fixa retornando um float."""
    pilha: List[float] = []
    for tipo, lexema in rpn:
        if tipo == 'INTEIRO':
            pilha.append(int(lexema))
        else:
            b, a = pilha.pop(), pilha.pop()
            pilha.append(operadores[tipo](a, b))
    return pilha[0]


# 4. Funcao principal (interface de linha de comando)

def principal() -> None:
    expressao = sys.argv[1] if len(sys.argv) > 1 else sys.stdin.read().strip()
    if not expressao:
        print("Erro: nenhuma expressão fornecida.", file=sys.stderr)
        sys.exit(1)

    tokens = tokenizar(expressao)
    print("TOKENS:", tokens)

    try:
        rpn = infixa_para_rpn(tokens)
        resultado = avaliar_rpn(rpn)
        print("VALOR :", resultado)
    except Exception as exc:
        print("Erro ao avaliar a expressão:", exc, file=sys.stderr)

if __name__ == "__main__":
    principal()
